QToolBar {{
    background-color: {secondary_color};
    spacing: 5px;
    border-radius: 4px;
    padding: 5px;
}}
QToolButton {{
    background-color: #383838;
    border: 1px solid #555;
    border-radius: 4px;
    color: white;
    padding: 4px;
    width: 24px; 
    height: 24px;
}}
QToolButton:hover {{
    background-color: #505050;
    border: 1px solid #777;
}}
QToolButton:checked {{
    background-color: {app_color};
    border: 1px solid #ffffffff;
}}
QLabel {{
    color: #aaaaaa;
    font-size: 11px;
    font-family: monospace;
    margin-left: 10px;
}}