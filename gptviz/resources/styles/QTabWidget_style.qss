/* --- SINGOLA LINGUETTA (Stato Normale) --- */
QTabBar::tab {{
    color: {text_main};
    
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;

    padding: 8px 16px;
    min-width: 80px;

    /* Bordi invisibili per preparare l'animazione */
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    
    margin-right: 2px; /* Spazio tra i tab */
}}

/* --- STATO: HOVER (Mouse sopra) --- */
QTabBar::tab:hover {{
    background-color: {secondary_color}; 
    color: #ffffff;
}}

/* --- STATO: SELECTED (Tab Attivo) --- */
QTabBar::tab:selected {{
    color: #ffffff;
    background-color: {secondary_color};
}}

QFrame{{
        background-color: {bg_dark};
}}
