QCheckBox {{
    color: {text_main};
    background-color: transparent;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 5px; 
    spacing: 8px; /* Spazio tra la casellina e il testo */
}}

/* --- L'INDICATORE (Il quadratino) --- */
QCheckBox::indicator {{
    width: 14px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid {text_main};
    background-color: {bg_dark}; 
}}

/* Hover stato non spuntato */
QCheckBox::indicator:unchecked:hover {{
    border: 1px solid {secondary_color};
    background-color: #2d2d2d;
}}

/* --- STATO SPUNTATO (Checked) --- */
QCheckBox::indicator:checked {{
    background-color: {app_color}; 
    border: 1px solid {text_main};
    image: url(%ASSETS_PATH%/utility/check.svg);
}}