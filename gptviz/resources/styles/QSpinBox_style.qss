/* --- CORPO PRINCIPALE --- */
QDoubleSpinBox, QSpinBox {{
    background-color: #2b2b2b;
    color: {text_main};
    
    border: 1px solid {border_console};
    border-radius: 6px;
    
    padding: 3px 30px 3px 15px;
    
    font-size: 14px;
    font-weight: 500;
    
    selection-background-color: {app_color};
    selection-color: #ffffff;
}}

/* --- STATO: HOVER (Mouse sopra il box) --- */
QDoubleSpinBox:hover, QSpinBox:hover {{
    border: 1px solid {text_main};
    background-color: {secondary_color};
}}

/* --- STATO: FOCUS (Sto scrivendo/cliccato) --- */
QDoubleSpinBox:focus, QSpinBox:focus {{
    border: 1px solid {text_main};
    background-color: {secondary_color};
}}

/* --- PULSANTI SU/GIÙ (Area click) --- */
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {{
    subcontrol-origin: border;
    width: 25px;
    background: transparent;
    border: none;
}}

/* Posizionamento Pulsante SU */
QDoubleSpinBox::up-button, QSpinBox::up-button {{
    subcontrol-position: top right;
    border-top-right-radius: 6px;
    margin-top: 1px;
    margin-right: 1px;
    height: 15px;
}}

/* Posizionamento Pulsante GIÙ */
QDoubleSpinBox::down-button, QSpinBox::down-button {{
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
    margin-bottom: 1px;
    margin-right: 1px;
    height: 15px;
}}

/* --- STATO HOVER DEI PULSANTINI --- */
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {{
    background-color: {terziary_color};
}}

/* --- ICONE FRECCE (SVG) --- */

QDoubleSpinBox::up-arrow, QSpinBox::up-arrow {{
    image: url(gptviz/resources/assets/attention_navigator/chevron_up.svg); 
    width: 10px;
    height: 10px;
}}

QDoubleSpinBox::down-arrow, QSpinBox::down-arrow {{
    image: url(gptviz/resources/assets/attention_navigator/chevron_down.svg);
    width: 10px;
    height: 10px;
}}

/* Stato Disabled (Opzionale) */
QDoubleSpinBox:disabled, QSpinBox:disabled {{
    color: {secondary_color};
    background-color: {bg_dark};
    border: 1px solid {border_console};
}}